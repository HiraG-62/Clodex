{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Clodex Hub のローカル画面にフォルダ選択と通知を許可する",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": ["dialog:allow-open", "notification:allow-is-permission-granted", "notification:allow-request-permission", "notification:allow-notify"]
}
