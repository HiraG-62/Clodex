{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "gui/**",
      "package.json",
      "biome.json",
      "!!**/dist",
      "!!**/node_modules",
      "!!gui/src-tauri/target",
      "!!gui/src-tauri/runtime",
      "!!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "complexity": { "useLiteralKeys": "off" } } }
    },
    {
      "includes": ["**/*.css"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" },
          "correctness": { "noInvalidGridAreas": "off" }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off"
      },
      "correctness": {
        "noVoidTypeReturn": "off",
        "useExhaustiveDependencies": "off"
      },
      "complexity": { "noUselessStringRaw": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
