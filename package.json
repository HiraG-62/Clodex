{
  "name": "clodex",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "bin": {
    "clodex": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "gui:dev": "pnpm build && node scripts/stage-gui-runtime.mjs && cd gui && pnpm exec tauri dev",
    "gui:build": "pnpm build && node scripts/stage-gui-runtime.mjs && cd gui && pnpm exec tauri build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:spikes": "vitest run --project spikes"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ink": "^8.0.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "node-pty"
    ]
  }
}
